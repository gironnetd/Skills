<?xml version="1.0"?>

<project name="Build Yolaine" default="core">

    <property name="application.name" value="yolaine"/>

    <!-- =================================================================== -->
    <!-- Variables                                                           -->
    <!-- =================================================================== -->
    <property name="home.dir" value="."/>    
    <property name="yolaine.home" value="${home.dir}"/>

    <!--Yolaine Properties-->
    <property name="yolaine.build.dir" value="${yolaine.home}/build"/>
    <property name="yolaine.config.dir" value="${yolaine.home}/config"/>
    <property name="yolaine.src.dir" value="${yolaine.home}/src"/>
    <property name="yolaine.web.dir" value="${yolaine.home}/resources"/>
    <property name="yolaine.web-inf.dir" value="${yolaine.home}/WEB-INF"/>
    <property name="yolaine.config.dir" value="${yolaine.home}/config/META-INF"/>
    <property name="yolaine.generated.src.dir" value="${yolaine.home}/generated"/>
    <property name="yolaine.classes.dir" value="${yolaine.home}/classes/production"/>
    <property name="yolaine.lib.dir" value="${yolaine.home}/lib"/>

    <!-- =================================================================== -->
    <!-- Fichier                                                             -->
    <!-- =================================================================== -->
    <!--YAPS Files-->
    <property name="yolaine.client.jar" value="${yolaine.build.dir}/${application.name}.jar"/>
    <property name="yolaine.utility.jar" value="${yolaine.build.dir}/lib/utility.jar"/>
    <property name="yolaine.ws.jar" value="${yolaine.build.dir}/lib/ws-interface.jar"/>
    <property name="yolaine.entity.jar" value="${yolaine.build.dir}/lib/entity.jar"/>
    <property name="yolaine.mdb.jar" value="${yolaine.build.dir}/mdb.jar"/>
    <property name="yolaine.stateless.jar" value="${yolaine.build.dir}/stateless.jar"/>
    <property name="yolaine.stateful.jar" value="${yolaine.build.dir}/stateful.jar"/>
    <property name="yolaine.war" value="${yolaine.build.dir}/${application.name}.war"/>
    <property name="yolaine.ear" value="${yolaine.build.dir}/${application.name}.ear"/>

    <!-- =================================================================== -->
    <!-- Utilitaires                                                         -->
    <!-- =================================================================== -->
    <property environment="env"/>
    <property name="glassfish.home" value="../Glassfish"/>
	
    <!--property name="glassfish.lib" value="${glassfish.home}/lib"/-->
    
	<property name="glassfish.lib" value="${glassfish.home}/glassfish/lib"/>
    <property name="glassfish.modules" value="${glassfish.home}/glassfish/modules"/>
    <property name="derby.home" value="${glassfish.home}/javadb"/>
    <property name="derby.lib" value="${derby.home}/lib"/>
    <property name="hibernate.lib" value="${glassfish.lib}/hibernate"/>

    <property name="asadmin" value="${glassfish.home}/bin/asadmin"/>
    <property name="wsgen" value="${glassfish.home}/bin/wsgen"/>
    <property name="wsimport" value="${glassfish.home}/bin/wsimport"/>
    <property name="echo" value="false"/>
    <property name="verifier" value="${glassfish.home}/bin/verifier"/>
    <property name="verifier.dir" value="${home.dir}/verifier"/>

    <!--Glassfish Properties-->
    <property name="server.user.name" value="admin"/>
    <property name="server.passwordfile" value="passwordfile"/>
    <property name="server.host" value="localhost"/>
    <property name="server.port" value="8080"/>
    <property name="server.admin.port" value="8282"/>

    <!--Database Properties-->
    <property name="db.host" value="localhost"/>
    <property name="db.sid" value="${application.name}DB"/>
    <property name="db.user" value="dbuser"/>
    <property name="db.password" value="dbpwd"/>

    <!--Derby-->
    <property name="db.port" value="1527"/>
    <property name="db.driver" value="org.apache.derby.jdbc.ClientDriver"/>
    <property name="db.url" value="jdbc:derby://${db.host}:${db.port}/${db.sid}"/>
    <!--MySQL-->
<!--    <property name="db.port" value="3306"/>-->
<!--    <property name="db.driver" value="com.mysql.jdbc.Driver"/>-->
<!--    <property name="db.url" value="jdbc:mysql://${db.host}:${db.port}/${db.sid}"/>-->

    <!-- =================================================================== -->
    <!-- Check variable                                                      -->
    <!-- =================================================================== -->
    <target name="check">
        <fail unless="env.GLASSFISH_HOME">
            ####
            #### You must install GlassFish V2 from https://glassfish.dev.java.net/public/downloadsindex.html
            #### And set the GLASSFISH_HOME variable
        </fail>
    </target>

    <!-- =================================================================== -->
    <!-- Classes et Jars utiliser pour compiler et executer l'application    -->
    <!-- =================================================================== -->
    <path id="classpath">
        <pathelement location="${glassfish.lib}/appserv-deployment-client.jar"/>
        <pathelement location="${glassfish.lib}/appserv-rt.jar"/>        
        <pathelement location="${glassfish.lib}/webservices-rt.jar"/>
        <pathelement location="${glassfish.lib}/appserv-admin.jar"/>
        <pathelement location="${glassfish.lib}/javaee.jar"/>  
        <pathelement location="${glassfish.lib}/toplink-essentials-agent.jar"/>
        <pathelement location="${glassfish.lib}/toplink-essentials.jar"/>
        <pathelement location="${glassfish.lib}/install/applications/jmsra/imqjmsra.jar"/>
        <pathelement location="${glassfish.lib}/antlr-2.7.6.jar"/>
        <pathelement location="${glassfish.lib}/asm.jar"/>        
        <pathelement location="${glassfish.lib}/asm-attrs.jar"/>
        <pathelement location="${glassfish.lib}/c3p0-0.9.1.jar"/>
        <pathelement location="${glassfish.lib}/cglib-2.1.3.jar"/>
        <pathelement location="${glassfish.lib}/commons-collections-2.1.1.jar"/>	
        <pathelement location="${glassfish.lib}/commons-logging-1.0.4.jar"/>
        <pathelement location="${glassfish.lib}/concurrent-1.3.2.jar"/>
        <pathelement location="${glassfish.lib}/dom4j-1.6.1.jar"/>
		<pathelement location="${glassfish.lib}/ehcache-1.2.3.jar"/>
        <pathelement location="${glassfish.lib}/hibernate3.jar"/>
        <pathelement location="${glassfish.lib}/hibernate-annotations.jar"/>
        <pathelement location="${glassfish.lib}/hibernate-commons-annotations.jar"/>
        <pathelement location="${glassfish.lib}/hibernate-entitymanager.jar"/>
        <pathelement location="${glassfish.lib}/hibernate-search.jar"/>	
        <pathelement location="${glassfish.lib}/hibernate-validator.jar"/>
        <pathelement location="${glassfish.lib}/javassist.jar"/>
        <pathelement location="${glassfish.lib}/jboss-archive-browsing.jar"/>
        <pathelement location="${glassfish.lib}/log4j-1.2.16.jar"/>
        <pathelement location="${glassfish.lib}/lucene-core-2.2.0.jar"/>
        <pathelement location="${hibernate.lib}/lib/required/hibernate-core-5.1.0.Final.jar"/>

        <!--Derby-->
        <pathelement location="${derby.lib}/derbyclient.jar"/>
        <!--MySQL-->
<!--        <pathelement location="${glassfish.lib}/mysql-connector-java-5.0.7-bin.jar"/>-->
    </path>
    <pathconvert pathsep="${line.separator}" property="convert.classpath" refid="classpath"/>

    <path id="yolaine-classpath">
        <pathelement location="${yolaine.config.dir}"/>
        <pathelement location="${yolaine.classes.dir}"/>
        <pathelement location="${yolaine.lib.dir}/vstm-xscore-0.5.0.jar"/>
        <pathelement location="${yolaine.lib.dir}/commons-lang-2.3.jar"/>
		<pathelement location="${yolaine.lib.dir}/jxl.jar"/>
        <pathelement location="${yolaine.lib.dir}/derby.jar"/>
		<pathelement location="${yolaine.lib.dir}/itextpdf-5.1.1.jar"/>
		<pathelement location="${yolaine.lib.dir}/itext-xtra-5.1.1.jar"/>
        <pathelement location="${glassfish.modules}/javax.persistence.jar"/>
        <pathelement location="${glassfish.modules}/javax.ejb.jar"/>
        <pathelement location="${glassfish.modules}/javax.jms.jar"/>
        <pathelement location="${glassfish.modules}/javax.faces.jar"/>
        <pathelement location="${glassfish.modules}/javax.servlet-api.jar"/>
        <pathelement location="${glassfish.modules}/javax.mail.jar"/>
    </path>
    <pathconvert pathsep="${line.separator}" property="convert.yolaine-classpath" refid="yolaine-classpath"/>

    <!-- =================================================================== -->
    <!-- Suppression des répertoires de travail                              -->
    <!-- =================================================================== -->

    <target name="clean">
        <antcall target="yolaine-clean"/>
    </target>

    <!-- Clean YAPS -->
    <target name="yolaine-clean">
        <echo message="Cleans the Yolaine environment"/>
        <delete dir="${yolaine.home}/classes"/>
        <delete dir="${yolaine.build.dir}"/>
    </target>    

    <!-- =================================================================== -->
    <!-- Creation des repertoires de travail                                 -->
    <!-- =================================================================== -->

    <target name="prepare">
        <antcall target="yolaine-prepare"/>
    </target>

    <!-- Prepare YOLAINE -->
    <target name="yolaine-prepare" depends="check">
        <echo message="Setup the Yolaine environment"/>
        <mkdir dir="${yolaine.classes.dir}"/>
        <mkdir dir="${yolaine.build.dir}/lib"/>
    </target>

    <!-- =================================================================== -->
    <!-- Compile le code source                                              -->
    <!-- =================================================================== -->
    <target name="compile" depends="prepare">
        <antcall target="yolaine-compile"/>
    </target>

    <!-- Compile YOLAINE -->
    <target name="yolaine-compile" depends="yolaine-prepare">
        <echo message="Compile the Yolaine generated classes"/>
        <echo message="${convert.classpath}"/>
        <echo message="${convert.yolaine-classpath}"/>
        <javac srcdir="${yolaine.generated.src.dir}"
               destdir="${yolaine.classes.dir}"
               includeantruntime="false"
               deprecation="on">
            <classpath refid="classpath"/>
            <classpath refid="yolaine-classpath"/>
        </javac>
        <echo message="Compile the Yolaine classes"/>
        <javac srcdir="${yolaine.src.dir}"
               destdir="${yolaine.classes.dir}"
               includeantruntime="false"
               deprecation="on">
            <classpath refid="classpath"/>
            <classpath refid="yolaine-classpath"/>
        </javac>
    </target>

    <!-- =================================================================== -->
    <!-- Build                                                               -->
    <!-- =================================================================== -->

    <target name="build" depends="compile">
        <antcall target="yolaine-build"/>
    </target>

    <!-- Build YAPS -->
    <target name="yolaine-build"
            depends="yolaine-compile,yolaine-build-client-jar,yolaine-build-stateless-jar,yolaine-build-stateful-jar,yolaine-build-mdb-jar,yolaine-build-entity-jar,yolaine-build-utility-jar,yolaine-build-ear"/>

    <target name="yolaine-build-client-jar">
        <echo message="Creates the Client jar"/>
        <jar jarfile="${yolaine.client.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/client/**/*.class"/>
                <include name="com/yolaine/entity/**/*.class"/>
                <include name="com/yolaine/util/**/*.class"/>
                <include name="com/yolaine/exception/**/*.class"/>
                <include name="com/yolaine/stateless/**/*Remote.class"/>
                <include name="org/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-stateless-jar">
        <echo message="Creates the EJB Stateless jar"/>
        <jar jarfile="${yolaine.stateless.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/stateless/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-stateful-jar">
        <echo message="Creates the EJB Stateful jar"/>
        <jar jarfile="${yolaine.stateful.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/stateful/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-mdb-jar">
        <echo message="Creates the EJB MDB jar"/>
        <jar jarfile="${yolaine.mdb.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/mdb/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-entity-jar">
        <echo message="Creates the EJB Entity jar"/>
        <jar jarfile="${yolaine.entity.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/entity/**/*.class"/>
            </fileset>
            <fileset dir="${yolaine.config.dir}">
                <include name="META-INF/persistence.xml"/>
				<include name="log4j.properties"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-utility-jar">
        <echo message="Creates the Utility jar"/>
        <jar jarfile="${yolaine.utility.jar}">
            <fileset dir="${yolaine.classes.dir}">
                <include name="com/yolaine/util/**/*.class"/>
                <include name="com/yolaine/exception/**/*.class"/>
            </fileset>
        </jar>
    </target>

    <target name="yolaine-build-ear">
        <echo message="Creates the Yolaine Enterprise Application"/>
        <delete file="${yolaine.ear}"/>
        <jar jarfile="${yolaine.ear}" basedir="${yolaine.build.dir}" excludes="${application.name}.jar"/>
    </target>

    <target name="yolaine-build-debug">
        <delete dir="${yolaine.build.dir}"/>
        <mkdir dir="${yolaine.build.dir}/lib"/>
        <antcall target="yolaine-build-client-jar"/>
        <antcall target="yolaine-build-stateless-jar"/>
        <antcall target="yolaine-build-stateful-jar"/>
        <antcall target="yolaine-build-mdb-jar"/>
        <antcall target="yolaine-build-entity-jar"/>
        <antcall target="yolaine-build-utility-jar"/>
<!--        <antcall target="yolaine-build-ws-jar"/>-->
<!--        <antcall target="yolaine-build-war"/>-->
        <antcall target="yolaine-build-ear"/>
    </target>

    <!-- =================================================================== -->
    <!-- Web Service Generator                                               -->
    <!-- =================================================================== -->  

    <!-- =================================================================== -->
    <!-- Web Service Import                                                  -->
    <!-- =================================================================== -->  

    <!-- =================================================================== -->
    <!-- Déploiement des Application                                         -->
    <!-- =================================================================== -->

    <target name="deploy">        
        <antcall target="yolaine-build"/>
        <antcall target="yolaine-deploy"/>
    </target>

    <!-- Deploy YAPS -->
    <target name="yolaine-deploy" depends="check">
        <echo message="Deploys the Yolaine application"/>
        <exec executable="${asadmin}">
            <arg line=" --echo=${echo}"/>
            <arg line=" --user ${server.user.name}"/>
            <arg line=" --passwordfile ${server.passwordfile}"/>
            <arg line=" --host ${server.host}"/>
            <arg line=" --port ${server.admin.port}"/>
            <arg line="deploy"/>
            <arg line=" ${yolaine.ear}"/>
        </exec>
    </target>

    <!-- =================================================================== -->
    <!-- Undeploiement des Application                                       -->
    <!-- =================================================================== -->
    <target name="undeploy">
        <antcall target="yolaine-undeploy"/>        
    </target>

    <!-- Undeploy YAPS -->
    <target name="yolaine-undeploy" depends="check">
        <echo message="Undeploys the Yolaine application"/>
        <exec executable="${asadmin}">
            <arg line=" --echo=${echo}"/>
            <arg line=" --user ${server.user.name}"/>
            <arg line=" --passwordfile ${server.passwordfile}"/>
            <arg line=" --host ${server.host}"/>
            <arg line=" --port ${server.admin.port}"/>
            <arg line="undeploy"/>
            <arg line=" ${application.name}"/>
        </exec>
    </target>
    
    <!-- =================================================================== -->
    <!-- Vérifie les applications                                            -->
    <!-- =================================================================== -->
    <target name="verify">
        <antcall target="yolaine-verify"/>
    </target>

    <!-- Verifies YOLAINE -->
    <target name="yolaine-verify" depends="check">
        <mkdir dir="${verifier.dir}"/>
        <exec executable="${verifier}">
            <arg line=" -d ${verifier.dir}"/>
            <arg line=" ${yolaine.ear}"/>
        </exec>
    </target>

    <!-- =================================================================== -->
    <!-- Autres                                                              -->
    <!-- =================================================================== -->

    <target name="show" depends="check">
        <exec executable="${asadmin}">
            <arg line="show-component-status"/>
            <arg line=" --echo=${echo}"/>
            <arg line=" --user ${server.user.name}"/>
            <arg line=" --passwordfile ${server.passwordfile}"/>
            <arg line=" --host ${server.host}"/>
            <arg line=" --port ${server.admin.port}"/>
            <arg line=" ${application.name}"/>
        </exec>
    </target>

    <!-- =================================================================== -->
    <!-- Execute l'application cliente                                       -->
    <!-- =================================================================== -->

    <target name="run-client">
        <echo message="Runs the client application"/>
        <java classname="com.yolaine.client.ui.PrincipalFrame" fork="yes" dir=".">
            <jvmarg value="-Djava.naming.factory.initial=com.sun.enterprise.naming.SerialInitContextFactory"/>
            <jvmarg value="-Djava.naming.provider.url=iiop://localhost:3700"/>
            <classpath>
                <pathelement location="${yolaine.client.jar}"/>
                <path refid="classpath"/>
                <path refid="yolaine-classpath"/>
            </classpath>
        </java>
    </target>

    <!-- =================================================================== -->
    <!-- Main                                                                -->
    <!-- =================================================================== -->
    <target name="core" depends="clean,build"/>

</project>
