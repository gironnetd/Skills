<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="http://java.sun.com/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="http://java.sun.com/xml/ns/persistence http://java.sun.com/xml/ns/persistence/persistence_1_0.xsd"
             version="1.0">

	<persistence-unit name="YolainePU">
		<provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <jta-data-source>jdbc/YolaineDS</jta-data-source>
        <class>com.yolaine.entity.catalogue.Article</class>
		<class>com.yolaine.entity.catalogue.Categorie</class>
		<class>com.yolaine.entity.catalogue.Couleur</class>
		<class>com.yolaine.entity.catalogue.Manche</class>
		<class>com.yolaine.entity.catalogue.Marque</class>
		<class>com.yolaine.entity.catalogue.Situation</class>
		<class>com.yolaine.entity.client.Civilite</class>
		<class>com.yolaine.entity.client.Client</class>
		<class>com.yolaine.entity.client.Depot</class>
		<class>com.yolaine.entity.client.TypeIdentite</class>
		<class>com.yolaine.entity.transaction.Banque</class>
		<class>com.yolaine.entity.transaction.Paiement</class>
		<class>com.yolaine.entity.transaction.Remboursement</class>
		<class>com.yolaine.entity.transaction.TypePaiement</class>
		<class>com.yolaine.entity.Adresse</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>
        <properties>
			<!-- connexion JDBC -->
			<property name="toplink.target-database" value="Derby"/>
			<property name="toplink.ddl-generation" value="drop-and-create-tables"/>
			<property name="toplink.create-ddl-jdbc-file-name" value="create.sql"/>
			<property name="toplink.drop-ddl-jdbc-file-name" value="drop.sql"/>
			<property name="toplink.logging.level" value="INFO"/>
        </properties>
    </persistence-unit>
</persistence>
